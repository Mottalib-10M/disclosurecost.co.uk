---
/** Renders one tool with its page defaults: the check finder (`finder`) or a mini-spec (`mini:<spec>`). */
import CheckFinder from './calc/CheckFinder';
import MiniSim from './calc/MiniSim';
import { route, ROUTES } from '../i18n/routes';
import { getSpec, roleIndex, forceIndex } from '../lib/mini-specs';
import type { ToolDef } from '../lib/guide-types';
interface Props { tool: ToolDef; primary?: boolean; idPrefix?: string }
const { tool, primary = false, idPrefix } = Astro.props;
const props = (tool.props ?? {}) as Record<string, any>;
const methodHref = route('method', 'en');
const kind = tool.kind;
const mini = kind.startsWith('mini:') ? kind.slice(5) : null;
const spec = mini ? getSpec(mini) : null;
const href = spec?.ctaPage ? route(spec.ctaPage, 'en') : undefined;
const numDefaults: Record<string, number> = {};
for (const [k, v] of Object.entries(props)) {
  if (typeof v === 'number') numDefaults[k] = v;
  else if (k === 'role' && typeof v === 'string') numDefaults[k] = roleIndex(v);
  else if (k === 'force' && typeof v === 'string') numDefaults[k] = forceIndex(v);
}
// Level pages the finder links to.
const has = (id: string) => ROUTES.some((r) => r.id === id);
const pages: Record<string, string> = {};
const map: Record<string, string> = { basic: 'basic-dbs-check', standard: 'standard-dbs-check', enhanced: 'enhanced-dbs-check', 'enhanced-cbl': 'dbs-barred-list', 'enhanced-abl': 'dbs-barred-list', 'enhanced-both': 'dbs-barred-list' };
for (const [l, id] of Object.entries(map)) if (has(id)) pages[l] = route(id, 'en');
---
{kind === 'finder' && <CheckFinder client:load {...props} pages={pages} methodHref={methodHref} idPrefix={idPrefix ?? 'f'} />}
{mini && <MiniSim client:load kind={mini} href={href} defaults={numDefaults} primary={primary} idPrefix={idPrefix ?? (primary ? 'p' : 'm')} />}
